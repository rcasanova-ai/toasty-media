# Toasty Peeps: local configuration. Copy to `.env` (git-ignored) ONLY if you want to change something.
# Every value below is a placeholder. The app runs without any of them: the demo at /peeps/demo/ needs no
# configuration at all, and the local API sandbox defaults to simulated payments and a recorded-not-sent email adapter.
# Never commit a real .env, a keypair file, or an API key.

# ---- Local API sandbox (scripts/dev.mjs sets sensible defaults; override only if needed) ----
# TOASTY_SESSION_SECRET=change-me-to-a-long-random-string
# PEEPS_TEST_ADAPTERS=1            # 1 = outreach emails are recorded locally, never sent, and labelled "simulated"

# ---- Optional: real Solana DEVNET verification of the Peeps introduction payment ----
# Setting a recipient turns the demo payment provider OFF and makes the server verify real transactions
# on-chain (recipient, USDC mint, amount, request-specific reference, replay protection).
# SVM_PAY_TO=<your devnet wallet address that receives the USDC>
# TOASTY_SOLANA_NETWORK=solana-devnet
# TOASTY_SOLANA_RPC_URL=https://api.devnet.solana.com
# TOASTY_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # Circle's public devnet USDC mint

# ---- Optional: real email (Resend). Without it, emails are logged to the console and marked "simulated" ----
# RESEND_API_KEY=<your Resend API key>
# TOASTY_EMAIL_FROM=Peeps <peeps@your-verified-domain.example>

# ---- Optional: closed beta ----
# PEEPS_BETA_REQUIRE_INVITE=1      # only invited (ACTIVE waitlist) people and platform admins may use Peeps
